# Copy this file to .env and fill in the key. .env is gitignored and must never
# be committed.
#
#   cp .env.example .env

# OpenAI-compatible endpoint. Only the final answer costs anything; retrieval and
# reranking run locally.
LLM_BASE_URL=https://api.gapgpt.app/v1
LLM_API_KEY=

# Which model answers by default. `python ask.py --models` lists what the key can
# actually reach.
LLM_MODEL=gpt-4o-mini

# The database holding the positions.
DATABASE_URL=postgresql://positions:positions@localhost:5432/positions

# Qdrant Cloud. The cluster URL includes the port; keep it.
QDRANT_URL=
QDRANT_API_KEY=
